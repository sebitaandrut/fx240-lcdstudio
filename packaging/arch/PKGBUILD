pkgver() {
  cd "$srcdir/fx240-lcdstudio"
  local version
  version=$(python -c "import tomllib; print(tomllib.load(open('pyproject.toml', 'rb'))['project']['version'])")
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/fx240-lcdstudio"
  python -m venv "$srcdir/build-env"
  export PIP_CONFIG_FILE=/dev/null
  export PIP_NO_INDEX=1
  export PYTHONNOUSERSITE=1
  unset PYTHONPATH PYTHONHOME VIRTUAL_ENV
  "$srcdir/build-env/bin/python" -m pip install --no-cache-dir --no-deps \
    --find-links="$srcdir" -r packaging/requirements-build.txt
  "$srcdir/build-env/bin/python" -m pip install --no-deps --no-build-isolation .
  "$srcdir/build-env/bin/python" tools/build_binary.py
}

check() {
  cd "$srcdir/fx240-lcdstudio"
  desktop-file-validate packaging/arch/org.fx240lcdstudio.desktop
  # Offscreen smoke alone cannot detect missing native X11/Wayland libraries.
  local plugin dependency_report
  for plugin in "$srcdir"/build-env/lib/python*/site-packages/PySide6/Qt/plugins/platforms/libqxcb.so \
                "$srcdir"/build-env/lib/python*/site-packages/PySide6/Qt/plugins/platforms/libqwayland*.so; do
    [[ -f "$plugin" ]] || continue
    dependency_report=$(ldd "$plugin") || return 1
    if grep -q 'not found' <<< "$dependency_report"; then
      printf '%s\n' "$dependency_report" >&2
      return 1
    fi
  done
  # Synthetic sensors, offscreen QML, no HID access and no preference writes.
  env -u PYTHONPATH -u PYTHONHOME -u VIRTUAL_ENV \
    PYTHONNOUSERSITE=1 ./dist/fx240-lcd-studio self-test
}

package() {
  cd "$srcdir/fx240-lcdstudio"
  install -Dm755 dist/fx240-lcd-studio "$pkgdir/usr/bin/fx240-lcd-studio"
  ln -s fx240-lcd-studio "$pkgdir/usr/bin/fx240"
  install -Dm644 packaging/arch/org.fx240lcdstudio.desktop \
    "$pkgdir/usr/share/applications/org.fx240lcdstudio.desktop"
  install -Dm644 src/fx240/assets/branding/tray-lcd-fallback.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.fx240lcdstudio.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
  install -Dm644 src/fx240/assets/fonts/OFL.txt \
    "$pkgdir/usr/share/licenses/$pkgname/Outfit-OFL.txt"
  install -Dm644 src/fx240/assets/icons/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/Lucide-LICENSE.txt"
  # Retain upstream wheel notices alongside the executable's embedded assets.
  local metadata
  for metadata in "$srcdir"/build-env/lib/python*/site-packages/*.dist-info; do
    if [[ -d "$metadata/licenses" ]]; then
      install -dm755 "$pkgdir/usr/share/licenses/$pkgname/third-party/$(basename "$metadata")"
      cp -r "$metadata/licenses" \
        "$pkgdir/usr/share/licenses/$pkgname/third-party/$(basename "$metadata")/"
    fi
  done
  local qt_licenses="$srcdir/build-env/lib/python3.14/site-packages/PySide6/Qt/licenses"
  if [[ -d "$qt_licenses" ]]; then
    cp -r "$qt_licenses" "$pkgdir/usr/share/licenses/$pkgname/Qt"
  fi
}
